<?xml version="1.0"?>
<package format="3">
  <name>gripper_config_loader</name>
  <version>0.1.0</version>
  <description>Loader node that validates a gripper YAML configuration and republishes it as ROS parameters.</description>

  <maintainer email="julien.rineau@berkeley.edu">Julien Rineau</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>PyYAML</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package> 